{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradingViewKraft",
  "version": "0.1.0",
  "identifier": "app.tradingviewkraft.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @tvk/web exec vite --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @tvk/web exec vite build --mode desktop",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "TradingViewKraft",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible",
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; worker-src 'self' blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "shortDescription": "Charts for crypto, US stocks and precious metals",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "plugins": {}
}
