# The Mac app bundles the web frontend, so it needs to know where the Vercel relay functions live.
# Copy this file to apps/web/.env.desktop before `pnpm desktop:build` (the build runs `vite build --mode desktop`).
VITE_RELAY_BASE=https://your-deployment.vercel.app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DATA_MODE=live
