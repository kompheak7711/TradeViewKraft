# ---------- Client-safe variables (bundled into the web build; never put secrets here) ----------
# Supabase project URL and anon (public) key. The anon key is safe to ship: row-level security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base URL of the Vercel deployment that hosts the relay functions. Leave empty for same-origin (web/PWA).
# The Mac app sets this to the production URL so /api/stocks and /api/metals work from Tauri.
VITE_RELAY_BASE=
# 'live' (default) or 'mock' (deterministic simulated data, used by e2e tests and offline development)
VITE_DATA_MODE=live

# ---------- Server-side secrets (Vercel project → Settings → Environment Variables; never prefixed with VITE_) ----------
# US stocks: the relay uses Alpaca when both ALPACA_* keys are set, otherwise Finnhub (live trades, quotes, search)
# combined with Twelve Data (history). Alpaca requires US tax residency; Finnhub and Twelve Data accept any country.
# Finnhub (free plan: 60 calls/min, 50 websocket symbols). https://finnhub.io → Dashboard → API key
FINNHUB_API_KEY=
# Alpaca Market Data (free plan, optional). https://app.alpaca.markets → API keys. Paper keys work for market data.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Alpaca data feed for the free plan: iex (sip requires a paid plan)
ALPACA_FEED=iex
# Twelve Data (free plan: 8 credits/min, 800/day). Used for gold/silver spot and, without Alpaca, for stock history. https://twelvedata.com
TWELVEDATA_API_KEY=
# Optional: comma-separated origins allowed to call the relay (defaults to same-origin + tauri://localhost)
RELAY_ALLOWED_ORIGINS=
